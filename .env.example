# freeMDlabor — environment variables.
# Copy to .env and fill in what you actually use. Nothing here is required
# just to search/dedup/PRISMA — those hit public, keyless APIs. Keys are
# only needed once you run `screen` or `extract` (an LLM role).

# --- Free-tier LLM providers (pick at least one; see config.yaml roles) ---

# Google AI Studio — free tier, generous quota. Get a key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Groq — free tier, very fast inference. Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional paid providers, only if you deliberately route a role here ---
# A Claude Pro subscription does NOT populate this — see PLAN.md §1.2.
# This is a separate, metered key from https://console.anthropic.com
ANTHROPIC_API_KEY=

OPENAI_API_KEY=

# --- Politeness / rate-limit headroom for the free, keyless APIs ---
# NCBI (PubMed): raises the E-utilities rate limit from 3 to 10 req/s.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Used as a "mailto" / User-Agent contact for NCBI, Crossref, and OpenAlex's
# polite pools — improves reliability, not required.
NCBI_CONTACT_EMAIL=
